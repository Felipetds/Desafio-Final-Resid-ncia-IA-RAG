base = next(
    b for b in manifesto["bases"]
    if b["base_id"] == "estruturada_pncp_rj"
)

filtros = base["selecao_deterministica"]

url = "https://pncp.gov.br/api/consulta/v1/contratacoes/publicacao"
parametros = {
    "dataInicial": filtros["dataInicial"],
    "dataFinal": filtros["dataFinal"],
    "codigoModalidadeContratacao": filtros["codigoModalidadeContratacao"],
    "uf": filtros["uf"],
    "pagina": 1,
    "tamanhoPagina": 10,
}

resposta = requests.get(url, params=parametros, timeout=(15, 60))

