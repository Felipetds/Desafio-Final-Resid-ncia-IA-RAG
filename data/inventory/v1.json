import requests
import time

url = "https://pncp.gov.br/api/consulta/v1/contratacoes/publicacao"

todos_registros = []

for pagina in range(1, 3):
    params = {
        "dataInicial": "20260301",
        "dataFinal": "20260331",
        "codigoModalidadeContratacao": 6,
        "uf": "RJ",
        "pagina": pagina,
        "tamanhoPagina": 10
    }

    resposta = requests.get(url, params=params, timeout=60)

    print(f"Página {pagina} - Status: {resposta.status_code}")

    dados = resposta.json()

    registros = dados["data"]
    todos_registros.extend(registros)

    print(f"Registros recebidos: {len(registros)}")

    time.sleep(2)

print("\nTotal coletado no teste:", len(todos_registros))


