    resultado = resposta.json()
    print("Registros nesta página:", len(resultado.get("data", [])))
    print("Total de páginas informado pelo PNCP:", resultado.get("totalPaginas"))
    print("Total de registros informado pelo PNCP:", resultado.get("totalRegistros"))
else:
    print("Resposta:", resposta.text[:1000])
