from pathlib import Path
from zipfile import ZipFile, ZIP_DEFLATED
from google.colab import files

raiz = Path("/content/repositorio1")
nomes = [
    "data/inventory/v1.json",
    "data/inventory/v2.json",
    "data/inventory/DIFF_v1_v2.md",
]
backup = Path("/content/inventarios_grande_desafio_atualizados.zip")

with ZipFile(backup, "w", compression=ZIP_DEFLATED) as pacote:
    for nome in nomes:
        arquivo = raiz / nome
        if not arquivo.is_file():
            raise FileNotFoundError(f"Arquivo não encontrado: {nome}")
        pacote.write(arquivo, arcname=nome)

print("ZIP atualizado criado:", backup.name)
files.download(str(backup))


