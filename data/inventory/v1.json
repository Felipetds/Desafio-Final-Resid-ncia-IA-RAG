import json
from pathlib import Path

original = Path(
    "data/raw/v1/estruturada/pncp/rj/pregao_eletronico/"
    "2026-03/contratacoes_publicacao.json"
)
nova_coleta = Path("data/raw/teste_fetch/contratacoes_publicacao_teste.json")
relatorio = Path("data/inventory/DIFF_v1_v2.md")

if relatorio.exists():
    print("Relatório já existe; nada foi sobrescrito.")
else:
    v1 = {
        item["numeroControlePNCP"]: item
        for item in json.loads(original.read_text(encoding="utf-8"))
    }
    v2 = {
        item["numeroControlePNCP"]: item
        for item in json.loads(nova_coleta.read_text(encoding="utf-8"))
    }

    apenas_v1 = sorted(v1.keys() - v2.keys())
    apenas_v2 = sorted(v2.keys() - v1.keys())
    alterados = []

    for identificador in sorted(v1.keys() & v2.keys()):
        if v1[identificador] != v2[identificador]:
            campos = sorted(
                chave for chave in v1[identificador].keys() | v2[identificador].keys()
                if v1[identificador].get(chave) != v2[identificador].get(chave)
            )
            alterados.append((identificador, campos))

    linhas = [
        "# Diferenças entre as coletas v1 e v2",
        "",
        "Base: contratações do PNCP, RJ, pregão eletrônico, março de 2026.",
        "",
        f"- IDs apenas na v1: {len(apenas_v1)}",
        f"- IDs apenas na v2: {len(apenas_v2)}",
        f"- Registros com conteúdo alterado: {len(alterados)}",
        "",
        "## Registros alterados",
        "",
    ]

    for identificador, campos in alterados:
        linhas.append(f"- `{identificador}` — campos: {', '.join(campos)}")

    linhas += [
        "",
        "## Alteração no valor homologado",
        "",
        "- ID: `39563911000162-1-000054/2026`",
        f"- Valor na v1: {v1['39563911000162-1-000054/2026'].get('valorTotalHomologado')}",
        f"- Valor na v2: {v2['39563911000162-1-000054/2026'].get('valorTotalHomologado')}",
        "",
        "Os dados acima registram diferenças entre respostas do PNCP; "
        "não estabelecem o motivo das alterações.",
        "",
    ]

    relatorio.parent.mkdir(parents=True, exist_ok=True)
    with relatorio.open("x", encoding="utf-8") as arquivo:
        arquivo.write("\n".join(linhas))

    print("Relatório criado:", relatorio)
    print("IDs apenas na v1:", len(apenas_v1))
    print("IDs apenas na v2:", len(apenas_v2))
    print("Registros alterados:", len(alterados))
