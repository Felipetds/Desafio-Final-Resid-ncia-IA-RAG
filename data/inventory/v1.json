import json

raiz = Path("/content/repositorio1")
inventario = raiz / "data/inventory/v2.json"
novo_caminho = "data/raw/v2/estruturada/pncp/rj/pregao_eletronico/2026-03/contratacoes_publicacao.json"

dados = json.loads(inventario.read_text(encoding="utf-8"))
caminho_antigo = dados.get("arquivo")

