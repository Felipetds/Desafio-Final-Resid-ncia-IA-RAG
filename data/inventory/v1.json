import requests
import time

url = "https://pncp.gov.br/api/consulta/v1/contratacoes/publicacao"

for pagina in range(28, 137):

    print(f"\nPágina {pagina} de 136")

    sucesso = False

    for tentativa in range(1, 6):

        try:
            resposta = requests.get(
                url,
                params={
                    "dataInicial": "20260301",
                    "dataFinal": "20260331",
                    "codigoModalidadeContratacao": 6,
                    "uf": "RJ",
                    "pagina": pagina,
                    "tamanhoPagina": 10
                },
                timeout=90
            )

            print(f"Tentativa {tentativa} - Status: {resposta.status_code}")

            if resposta.status_code == 200:

                dados = resposta.json()
                registros = dados["data"]

                todos_registros.extend(registros)

                print("Registros recebidos:", len(registros))
                print("Total acumulado:", len(todos_registros))

                sucesso = True
                break

            else:
                print("Resposta não esperada.")
                print(resposta.text[:300])
                print("Aguardando 10 segundos...")
                time.sleep(10)

        except requests.exceptions.RequestException as erro:

            print("Erro de conexão:", erro)
            print("Aguardando 10 segundos...")
            time.sleep(10)

    if not sucesso:

        print(f"\nATENÇÃO: página {pagina} não foi coletada.")
        print("A coleta foi interrompida para não perder o controle dos dados.")
        break

    time.sleep(3)

print("\n================================")
print("COLETA PARCIAL/FINALIZADA")
print("================================")
print("Total de registros:", len(todos_registros))

