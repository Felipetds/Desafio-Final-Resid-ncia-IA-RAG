import copy
from pathlib import Path
import yaml

original = Path("corpus_manifest.yaml")
arquivo_teste = Path("data/raw/teste_fetch/manifesto_teste.yaml")

if arquivo_teste.exists():
    print("Manifesto de teste já existe; nada foi sobrescrito.")
else:
    manifesto_teste = copy.deepcopy(
        yaml.safe_load(original.read_text(encoding="utf-8"))
    )

    base = next(
        item for item in manifesto_teste["bases"]
        if item["base_id"] == "estruturada_pncp_rj"
    )
    # O caminho é relativo à pasta do manifesto de teste.
    base["arquivo_local"] = "contratacoes_publicacao_teste.json"

    arquivo_teste.parent.mkdir(parents=True, exist_ok=True)
    arquivo_teste.write_text(
        yaml.safe_dump(
            manifesto_teste,
            allow_unicode=True,
            sort_keys=False,
        ),
        encoding="utf-8",
    )
    print("Manifesto de teste criado:", arquivo_teste)

print(
    "Destino de teste:",
    arquivo_teste.parent / "contratacoes_publicacao_teste.json",
)
