from pathlib import Path
import zipfile

backup = Path("/content/backup_bases_grande_desafio_atualizado.zip")
destino_base = Path("/content/repositorio1/data")
restaurados = 0
existentes = 0

with zipfile.ZipFile(backup) as arquivo:
    for item in arquivo.infolist():
        if item.is_dir():
            continue

        caminho = Path(item.filename)

        # Aceita apenas arquivos dentro da pasta raw/ do backup.
        if caminho.is_absolute() or ".." in caminho.parts or caminho.parts[0] != "raw":
            raise ValueError(f"Caminho inesperado no ZIP: {item.filename}")

        destino = destino_base.joinpath(*caminho.parts)

        if destino.exists():
            existentes += 1
            continue

        destino.parent.mkdir(parents=True, exist_ok=True)

        # Modo "xb": impede sobrescrita mesmo se o arquivo surgir nesse intervalo.
        with arquivo.open(item) as origem, destino.open("xb") as saida:
            import shutil
            shutil.copyfileobj(origem, saida)

        restaurados += 1

print("Arquivos restaurados:", restaurados)
print("Arquivos já existentes, não sobrescritos:", existentes)
