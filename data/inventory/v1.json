import requests
import time
import json
from pathlib import Path

url = "https://pncp.gov.br/api/consulta/v1/contratacoes/publicacao"

todos_registros = []

total_paginas = 136

for pagina in range(1, total_paginas + 1):

    print(f"\nPágina {pagina} de {total_paginas}")

    sucesso = False

    for tentativa in range(1, 4):

        try:
            resposta = requests.get(
                url,
                params={
                    "dataInicial": "20260301",
                    "dataFinal": "20260331",
                    "codigoModalidadeContratacao": 6,
                    "uf": "RJ",
                    "pagina": pagina,
                    "tamanhoPagina": 10
                },
                timeout=60
            )

            print(f"Tentativa {tentativa} - Status: {resposta.status_code}")

            if resposta.status_code == 200:

                dados = resposta.json()

                registros = dados["data"]

                todos_registros.extend(registros)

                print(f"Registros recebidos: {len(registros)}")
                print(f"Total acumulado: {len(todos_registros)}")

                sucesso = True
                break

            else:
                print("Falha temporária. Aguardando 5 segundos...")
                time.sleep(5)

        except Exception as erro:
            print("Erro:", erro)
            print("Aguardando 5 segundos...")
            time.sleep(5)

    if not sucesso:
        print(f"ERRO: não foi possível coletar a página {pagina}.")
        break

    time.sleep(2)

print("\n================================")
print("COLETA FINALIZADA")
print("================================")
print("Total de registros coletados:", len(todos_registros))

